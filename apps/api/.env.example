NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://twiqo:twiqo@localhost:5432/twiqo_dev
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
RATE_LIMIT_DISABLED=false
VIDEO_PROVIDER=local
# Bunny Stream (set VIDEO_PROVIDER=bunny to use it)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=fake
# Stripe (set PAYMENT_PROVIDER=stripe to use it; use test keys until you launch)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Stripe Price id (price_...) of the Business Pro monthly subscription; also add customer.subscription.created/updated/deleted to the webhook events
STRIPE_PRICE_BUSINESS_PRO=

# --- Phase 6 ---
# Email: 'fake' only records messages (development). Production needs smtp, e.g. smtps://user:pass@smtp.provider.com
EMAIL_PROVIDER=fake
SMTP_URL=
EMAIL_FROM=twiqo <no-reply@yourdomain.example>
# Web push (npx web-push generate-vapid-keys). Leave empty to switch push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.example
# Optional: POST a short message here when the API hits an unexpected error (Slack/Discord-style webhook), and set LOG_LEVEL=debug|info|warn|error
ERROR_WEBHOOK_URL=
LOG_LEVEL=info
